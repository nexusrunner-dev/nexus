# ────────────────────────────────────────────────────────────────
#  NEXUS BACKEND — environment configuration
#  Copy this file to ".env" and fill in your real values.
# ────────────────────────────────────────────────────────────────

# --- Core ---
# Port the API/webhook server listens on (Railway sets PORT automatically).
PORT=8080
# Public base URL of THIS backend once deployed (used to register Helius webhooks).
# Locally you can use an ngrok URL; in production use your Railway domain.
PUBLIC_BASE_URL=https://your-backend.up.railway.app
# Comma-separated list of dashboard origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,https://your-dashboard.up.railway.app

# --- Database (Postgres). Railway injects DATABASE_URL automatically. ---
DATABASE_URL=postgresql://user:password@localhost:5432/nexus?schema=public

# --- Helius (Solana RPC + real-time wallet webhooks) ---
# Get a key at https://dashboard.helius.dev
HELIUS_API_KEY=

# --- Birdeye (token prices / overview / OHLCV) ---
# Get a key at https://birdeye.so  (Standard/Starter paid plan recommended)
BIRDEYE_API_KEY=

# --- Anthropic (pump analysis) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used for analysis summaries (claude-opus-4-8 = best; claude-sonnet-4-6 = cheaper).
ANTHROPIC_MODEL=claude-opus-4-8

# --- Telegram (notifications) ---
# Create a bot via @BotFather, paste its token here.
TELEGRAM_BOT_TOKEN=
# Your personal chat id. DM your bot and send /start to have it tell you the id,
# or set it here directly. Can also be managed from the dashboard Settings page.
TELEGRAM_CHAT_ID=

# --- Shared secret to protect the Helius webhook endpoint ---
# Any random string; Helius sends it back in the Authorization header.
WEBHOOK_AUTH_TOKEN=change-me-to-a-long-random-string

# --- Tuning (sensible defaults; override if you like) ---
# How often (seconds) to poll watchlist + wallet-held token prices.
PRICE_POLL_SECONDS=45
# Default watchlist alert: percent move within the lookback window to trigger.
WATCH_DEFAULT_MOVE_PCT=15
# Lookback window (minutes) for the percent-move check.
WATCH_DEFAULT_WINDOW_MIN=5
# Minimum minutes between repeat alerts for the same token/condition.
ALERT_COOLDOWN_MIN=10
