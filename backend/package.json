{
  "name": "nexus-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus — Solana wallet tracker, memecoin watchlist & pump analysis backend",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
